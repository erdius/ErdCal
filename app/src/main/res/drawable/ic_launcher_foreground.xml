<?xml version="1.0" encoding="utf-8"?>
<!-- Original artwork for this fork's launcher icon. A desk-calendar glyph:
     two binding-ring marks, a card body drawn as four separate solid
     border strips, a header-divider bar, and a small grid of date marks
     with one rendered as a circle (today) instead of a square. Smaller
     and thinner-lined than a first pass, with more surrounding margin.
     Every path is a plain non-overlapping solid fillColor rectangle/circle,
     no strokeColor/strokeWidth and no fillType="evenOdd", since at least
     one launcher this app targets (Mudita Kompakt) doesn't reliably render
     those (they render as a solid-filled block instead of a transparent
     outline). The upstream icon used stroked rounded-rect outlines, which
     would hit that exact issue. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Binding rings -->
    <path android:fillColor="#000000" android:pathData="M42,27 L46,27 L46,37 L42,37 Z" />
    <path android:fillColor="#000000" android:pathData="M62,27 L66,27 L66,37 L62,37 Z" />

    <!-- Calendar body outline, as four separate solid border strips -->
    <path android:fillColor="#000000" android:pathData="M30,36 L78,36 L78,39 L30,39 Z" />
    <path android:fillColor="#000000" android:pathData="M30,79 L78,79 L78,82 L30,82 Z" />
    <path android:fillColor="#000000" android:pathData="M30,36 L33,36 L33,82 L30,82 Z" />
    <path android:fillColor="#000000" android:pathData="M75,36 L78,36 L78,82 L75,82 Z" />

    <!-- Header divider -->
    <path android:fillColor="#000000" android:pathData="M33,46 L75,46 L75,48 L33,48 Z" />

    <!-- Date-grid marks; one mark is a circle (today) -->
    <path
        android:fillColor="#000000"
        android:pathData="M36,52 L42,52 L42,58 L36,58 Z
                           M63,52 L69,52 L69,58 L63,58 Z
                           M36,68 L42,68 L42,74 L36,74 Z
                           M51,68 L57,68 L57,74 L51,74 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M57,55 A3,3 0 1,1 50.999,55 A3,3 0 1,1 57,55 Z" />
</vector>
