<?xml version="1.0" encoding="utf-8"?>
<!-- Original artwork for this fork's launcher icon. A desk-calendar glyph:
     two binding-ring marks, a card body drawn as four separate solid
     border strips, a header-divider bar, and a small grid of date marks
     with the middle one rendered as a circle (today) instead of a square.
     Every path is a plain non-overlapping solid fillColor rectangle/circle,
     no strokeColor/strokeWidth and no fillType="evenOdd", since at least
     one launcher this app targets (Mudita Kompakt) doesn't reliably render
     those (they render as a solid-filled block instead of a transparent
     outline). The upstream icon used stroked rounded-rect outlines, which
     would hit that exact issue. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Binding rings -->
    <path
        android:fillColor="#000000"
        android:pathData="M34,20 L41,20 L41,36 L34,36 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M67,20 L74,20 L74,36 L67,36 Z" />

    <!-- Calendar body outline, as four separate solid border strips -->
    <path android:fillColor="#000000" android:pathData="M22,30 L86,30 L86,35 L22,35 Z" />
    <path android:fillColor="#000000" android:pathData="M22,83 L86,83 L86,88 L22,88 Z" />
    <path android:fillColor="#000000" android:pathData="M22,30 L27,30 L27,88 L22,88 Z" />
    <path android:fillColor="#000000" android:pathData="M81,30 L86,30 L86,88 L81,88 Z" />

    <!-- Header divider -->
    <path
        android:fillColor="#000000"
        android:pathData="M27,44 L81,44 L81,48 L27,48 Z" />

    <!-- Date-grid marks; the middle mark is a circle (today) -->
    <path
        android:fillColor="#000000"
        android:pathData="M30,54 L38,54 L38,62 L30,62 Z
                           M66,54 L74,54 L74,62 L66,62 Z
                           M30,70 L38,70 L38,78 L30,78 Z
                           M48,70 L56,70 L56,78 L48,78 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M56,58 A4,4 0 1,1 47.999,58 A4,4 0 1,1 56,58 Z" />
</vector>
