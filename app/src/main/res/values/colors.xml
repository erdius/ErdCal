<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monochrome only. This app never relies on hue for anything, to
         match the e-ink "pure black on white, no gradients" scheme the
         Mudita MMD library already uses for the in-app UI. These back the
         Android-level theme (status bar, splash screen), which previously
         still had the unused default Android Studio template's purple/teal
         Material colors. -->
    <color name="gray_dark">#FF333333</color>
    <color name="gray_mid">#FF666666</color>
    <color name="gray_light">#FFCCCCCC</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>