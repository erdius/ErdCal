<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.ErdCal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/gray_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/gray_mid</item>
        <item name="colorSecondaryContainer">@color/gray_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar matches the dark theme's black app background -->
        <item name="android:statusBarColor">@color/black</item>
    </style>
</resources>